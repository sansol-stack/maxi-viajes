# ════════════════════════════════════════════════════════════
# Maxi Viajes - Configuración Apache / Hostinger
# ════════════════════════════════════════════════════════════

RewriteEngine On

# ── 1. Redirección sin-www → www ──────────────────────────────
RewriteCond %{HTTP_HOST} ^maxiviajestraslados\.com\.ar$ [NC]
RewriteRule ^(.*)$ https://www.maxiviajestraslados.com.ar/$1 [R=301,L]

# ── 2. Forzar HTTPS ────────────────────────────────────────────
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# ── 3. SPA fallback — React Router ────────────────────────────
# Si la ruta solicitada NO es un archivo ni carpeta real
# (ej: /terminos, /flota), servir index.html y dejar que
# React Router maneje el routing en el cliente.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
